{
  "name": "rastrillo-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node hack/gen-design-system.mjs && node hack/gen-tour.mjs && eleventy",
    "serve": "node hack/gen-design-system.mjs && node hack/gen-tour.mjs && eleventy --serve",
    "check": "npm run build && node hack/check-anchors.mjs _site/index.html && node hack/check-docs.mjs && node hack/check-fences.mjs && node hack/check-tour.mjs",
