    "gen-tour": "node hack/gen-tour.mjs",
    "sync-docs": "node hack/sync-docs.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0"
  }
