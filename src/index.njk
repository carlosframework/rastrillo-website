      <div class="body">
        <h2 id="h-start">Get started</h2>
        <fieldset class="paths">
          <legend class="sr">Choose how to start</legend>
          <input type="radio" name="path" id="path-agent" checked>
          <label for="path-agent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
            With an agent</label>
          <input type="radio" name="path" id="path-hand">
          <label for="path-hand">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19h8"/><path d="m4 17 6-6-6-6"/></svg>
            By hand</label>

          <div class="panel panel-agent">
            <p>Paste this into your agent of choice</p>
            <div class="prompt">
              <pre id="agent-prompt">Build me a <span class="ph">[describe your app]</span> with Rastrillo. Read https://rastrillo.org/SKILL.md first. Then install the CLI with go install amadan.net/rastrillo/rastrillo/cmd/rastrillo@latest, run rastrillo new, and keep go test ./... passing as you go.</pre>
              <!-- Hidden until the script can make it work. -->
              <button class="copy" type="button" hidden aria-label="Copy prompt" title="Copy prompt" data-for="agent-prompt">
                <svg class="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <svg class="i-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
              <span class="sr" role="status" id="copy-status"></span>
            </div>
          </div>

          <div class="panel panel-hand">
            <ol class="steps">
              <li>
                <span class="basin-n" aria-hidden="true">1</span>
                <div>
                  <h3>Clone the repo</h3>
                  <pre class="cmd"><code><span class="k">git</span> clone https://github.com/rastrilloorg/rastrillo &amp;&amp; cd rastrillo/examples/notes</code></pre>
                </div>
              </li>
              <li>
                <span class="basin-n" aria-hidden="true">2</span>
                <div>
                  <h3>Run it</h3>
                  <pre class="cmd"><code>CGO_ENABLED=0 <span class="k">go</span> run ./cmd/notes -addr localhost:8080</code></pre>
                  <p>Sign up, write a note. Open a private window, sign up as someone else, and try to reach the first note by URL: 404.</p>
                </div>
              </li>
              <li>
                <span class="basin-n" aria-hidden="true">3</span>
                <div>
                  <h3>Start your own</h3>
                  <pre class="cmd"><code><span class="k">go</span> install amadan.net/rastrillo/rastrillo/cmd/rastrillo@latest
<span class="k">rastrillo</span> new myapp &amp;&amp; cd myapp &amp;&amp; go mod tidy &amp;&amp; go test ./...</code></pre>
                </div>
              </li>
            </ol>
          </div>
        </fieldset>
      </div>
